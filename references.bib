Version Number: 3},
	keywords = {FOS: Computer and information sciences, Machine Learning (cs.LG), Artificial Intelligence (cs.AI), Computation and Language (cs.CL)},
	file = {Full Text PDF:/Users/sobhanchatterjee/Zotero/storage/R8PUDR7M/Zhou et al. - 2023 - A Comprehensive Survey on Pretrained Foundation Mo.pdf:application/pdf},
