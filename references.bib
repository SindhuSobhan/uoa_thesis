	keywords = {Antidepressant medications, Caffeine, Hypothalamic–pituitary–adrenal activation, Neural substrates, Polysomnography},
	pages = {1600910},
	file = {Full Text PDF:/Users/sobhanchatterjee/Zotero/storage/6SFYAHVD/Liu et al. - 2017 - Low dose of caffeine enhances the efficacy of anti.pdf:application/pdf},
